# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=ollama.example.com

APP_ORG_NAME=Ollama

# Signs Open WebUI sessions and encrypted credentials, 32 characters or longer
APP_SECRET_KEY=replace-with-a-random-32-byte-hex-string

# How long a model stays loaded in memory, Go duration such as 5m or 1h
OLLAMA_KEEP_ALIVE=5m

# How many models may be resident at once, raise only with enough RAM
OLLAMA_MAX_LOADED_MODELS=1

# How many model requests are handled at the same time
OLLAMA_NUM_PARALLEL=1

# ComfyUI startup flags, --cpu forces CPU inference
COMFYUI_ARGS=--cpu
